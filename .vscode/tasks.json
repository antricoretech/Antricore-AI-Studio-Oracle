{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Free: GPU & Model Doctor",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "studio.free_cli",
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Free: Studio Local Dashboard",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "uvicorn",
        "studio.app:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Free: Unit Tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": []
}
